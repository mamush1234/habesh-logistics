# Railway: GitHub service named frontend, root directory /frontend, Dockerfile builder.
# Only this service needs a public domain. Set its public target port to 3000.
# Set its Railway deployment healthcheck path to /healthz.
# Keep VITE_API_URL empty: browser requests use /api on the frontend's own domain.
# API_UPSTREAM is a runtime host:port, NOT a URL or browser-accessible address.
# Rename "backend" in the reference if your Railway backend service has another name.
PORT=3000
VITE_API_URL=
API_UPSTREAM=${{backend.RAILWAY_PRIVATE_DOMAIN}}:8080
# Railway terminates HTTPS; this image forwards /api to the backend privately.
# The Docker image discovers its DNS resolvers and re-resolves backend addresses.
# Do not override the Docker entrypoint or start command.
