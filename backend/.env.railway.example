# Railway: GitHub service named backend, root directory /backend, Dockerfile builder.
# Add a PostgreSQL service named Postgres in the SAME project/environment first.
# Do not generate a public backend domain or expose the database through a TCP proxy.
# Copy these variable values into Railway's Variables editor, not into Git.
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
# Dual-stack binding also supports Railway environments with IPv6-only private networking.
SERVER_ADDRESS=::
DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DEMO_DATA_ENABLED=false
API_DOCS_ENABLED=false
JWT_EXPIRATION_MS=3600000
# Generate a unique 32-byte random secret. Never commit the filled values.
JWT_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Initially use the frontend's Railway HTTPS domain; change both after custom DNS setup.
APP_WEBSITE_URL=https://travel.habeshlist.com
CORS_ORIGINS=https://travel.habeshlist.com
# Railway permits SMTP only on Pro and higher plans. Keep disabled on Hobby/Trial.
# An HTTPS email-provider integration is required for automatic email on those plans.
# https://docs.railway.com/networking/outbound-networking
# Manual invitation links remain available without email.
INVITATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=habeshalist@gmail.com
SMTP_PASSWORD=
SMTP_FROM=habeshalist@gmail.com
